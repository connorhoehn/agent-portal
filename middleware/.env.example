# Middleware settings that change the security or money posture.
# The deployed task sets these in infra/lib/middleware-service-stack.ts; set
# them the same way anywhere the middleware runs against real AWS.

# The one development switch (docs/fail-open-audit.md §2). With it unset every
# security default is closed, whatever NODE_ENV says: a process without
# SESSION_SIGNING_SECRET_ARN and POLICY_STORE_ID refuses to start. `true`
# (never honoured when NODE_ENV=production) opens, for local work only:
#   - start-up without a signing secret ARN or a policy store
#   - session cookies signed with the published dev key (no ARN, no SESSION_SIGNING_KEY_DEV)
#   - Cedar decisions from the seed policies when POLICY_STORE_ID is unset
#   - the anonymous demo identity and the passwordless picker (as AUTH_DEMO_MODE=true does)
#   - machine callbacks with their *_SECRET unset (approvals, harness trace,
#     assessment run-complete, lab, mock control) pass instead of answering 503
#   - realtime tokens signed with the published dev secret (no REALTIME_JWT_SECRET)
#   - browser origins on localhost / 127.0.0.1 / [::1] (the Vite portal)
#   - the E2E reset routes under /api/observability/test-fixtures
#   - a plaintext ws:// public document gateway
# `npm run dev`, `npm run dev:mock`, docker-compose.yml and the jest setup set it.
# Never set it in a deployed task (infra/test/middleware-service-stack.test.ts).
# INSECURE_DEV_MODE=true

# Money (docs/next-steps.md §8 work item 16, §9 item 1)
# Who answers for spend charged to no initiative:
#   actor  (default) the spender's own user budget; refused only when there is
#          no actor either (a service call with no initiative)
#   allow  as actor, but a call with nobody to charge goes through unjudged
#          (local mock profiles; `npm run dev:mock` sets it)
#   refuse every spend with no initiative is refused (a hardened deploy)
SPEND_HOLDS_UNATTRIBUTED=actor
# Refuse (503) when budget or hold state cannot be read. Unset = on; `false`
# proceeds unbraked.
BUDGET_FAIL_CLOSED=true
# Per-user cap on POST /api/agents/:id/invoke, requests per minute (default 30).
AGENT_INVOKE_RATE_PER_MIN=30
# What one agent invoke is held at before the runtime is called, in USD (default 0.05),
# and how long that hold may stay open in milliseconds (default 900000, plus 5 minutes grace).
AGENT_INVOKE_P75_USD=0.05
AGENT_INVOKE_HOLD_TTL_MS=900000

# Row-level security (docs/next-steps.md §8 work item 22, schema/row_level_security.sql)
# Send the request's tenants as app.tenant (begin, set_config, statement, commit) on
# every Data API statement that touches a tenant table. Unset = on. `false` is the
# opt-out for the dbMasterSecret fallback (the master owns the tables, RLS skips it,
# so enforcing there only costs round trips). Off with the middleware login
# (<prefix>-aurora-middleware-credentials) makes every tenant table read empty, and
# says so at start.
# RLS_ENFORCE=true

# Service auth
# Static x-*-auth callback headers; every signer sends the request envelope now.
# Unset refuses; only `accept` (or `allow`) takes the static header.
SERVICE_AUTH_LEGACY_HEADERS=refuse
# Body-only envelopes on /internal/devbox and /internal/work-graph/compute-capabilities.
# Unset refuses. platform-api still signs body-only, so set accept where it calls
# these routes, for one release; drop it once it signs with signServiceRequest.
SERVICE_AUTH_LEGACY_BODY_ONLY=accept

# Local compute (docs/next-steps.md §9 item 3)
# Extra git hosts a machine may be handed a repo on, comma-separated bare host
# names (GitHub Enterprise, GitLab). github.com is always allowed. Set the same
# value on each worker (tools/local-compute-worker.mjs), which re-checks it.
# LOCAL_ALLOWED_REPO_HOSTS=github.example.com,gitlab.com

# Voice navigator (docs/voice-navigator-spec.md §8)
# Copy this file to middleware/.env (gitignored; loaded by src/config.ts, a variable already exported wins).
# The server-side OpenAI platform key; it never reaches the browser and is read
# only by src/lib/voice/openai.ts. Unset (or REPLACE_ME) makes
# POST /api/voice/sessions answer 503 voice-unavailable and the dock say why.
# OPENAI_API_KEY=sk-...
# A scripted session with no OpenAI call, so the dock and its tool loop run offline. dev:mock sets it
# to 1 by itself when no key is present.
# MOCK_VOICE=1
# The voice model (default gpt-live-1).
# VOICE_LIVE_MODEL=gpt-live-1
# The Responses model that runs the tools (default gpt-6-luna); off = the voice answers but every tool is off.
# VOICE_DELEGATION_MODEL=gpt-6-luna
# A built-in voice name or a voice_... id; unset = the model's default voice.
# VOICE_VOICE=
# The price per minute of voice the ledger books (default 0.05, OpenAI's gpt-live-1 list price read 2026-11-08).
# VOICE_USD_PER_MINUTE=0.05
# USD per million delegated-model tokens, overriding the price table's row for VOICE_DELEGATION_MODEL
# (gpt-6-luna defaults: 0.10 in, 0.01 cached in, 0.50 out; src/lib/model-prices-defaults.ts). Each ledger
# session books a second row, <id>:tokens, at this price; cached input is priced at the input override.
# VOICE_DELEGATION_USD_PER_1M_INPUT=0.10
# VOICE_DELEGATION_USD_PER_1M_OUTPUT=0.50
# Minutes a session is held at when it starts (the hold is this x the rate).
# VOICE_SESSION_MINUTES_P75=10
# The session ceiling: the hold expires and the reaper closes the session after this plus five minutes.
# VOICE_SESSION_MAX_MINUTES=30
