  "defectsFoundByHarness": [
    "message-queue Dockerfile omitted scripts/build.mjs, so 0.5.0 images could not build (fixed fa4aad9).",
    "ddb-v2 capped retention at 14 days while the legacy store accepted the 30/90/365-day catalog declarations; work-graph queue creation failed (0.5.1).",
    "platform-api outbox drainer marked accepted events FAILED after three transient broker failures in about six seconds (fixed 8802d4e).",
    "platform-api work-graph consumer created the shared queue without its declared policy; producers then hit ConfigurationConflict (fixed 8a0be3f).",
    "platform-api background catalog reconnect never started durable consumers (fixed d7ff8a2).",
    "platform-api revoked an open work-graph stream (policy-changed) on its day's first activity: the authorization revision's base hashed source health and an empty day lists no sources (fixed e0be5e0; found by the WebSocket leg)."
  ],
  "enabledProfiles": {
    "message-queue": "ddb-v2 durable-single and durable-replicated (incl. production; 0.5.3)",
    "platform-api": "PLATFORM_RUNTIME_PROFILE=durable with PLATFORM_DATASTORE aws-dynamodb or dynamodb-local",
    "aws-agentcore": "ORGIQ_RUNTIME_PROFILE=durable (static and unit verified; not run against live Aurora)"
  },
  "unsupported": [
    "memory and legacy ddb stores for any durable profile",
    "managed-nosql-store as the platform datastore (declares no transaction capability)",
    "AgentCore durable profile on Aurora (credentials invalid since early October)"
  ],
  "notCovered": [
    "browser rendering of the stream (the reader is a protocol client)",
    "AWS, capacity and cross-AZ brokers",
    "legacy-to-ddb-v2 migration ran only on DynamoDB Local tables, never a shared or cloud table",
    "platform-api losing Redis while the gateway keeps it (the case only the projection consumer covers) is unit-tested, not staged in the harness"
  ]
