# Vite env vars (must be prefixed with VITE_ to be exposed to the browser bundle).
# Copy to `.env.local` and override as needed for local dev.

# Base URL of the websocket-gateway HTTP API. Used by GatewayStatusBadge
# (and any future @connorhoehn/realtime-modules/proxy-client consumers) to
# poll `/health`. In Tilt the gateway is forwarded to host port 18080
# (see websocket-gateway/Tiltfile); inside docker-compose it's reachable as
# `http://gateway:8080`.
VITE_GATEWAY_URL=http://localhost:8080
# When running without websocket-gateway (docker-compose middleware only),
# set to http://localhost:3001 — the middleware now accepts WS at /ws.
# VITE_GATEWAY_URL=http://localhost:3001
