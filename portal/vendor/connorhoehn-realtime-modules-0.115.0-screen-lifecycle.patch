+    await act(async () => { endTrack(f.screenVideo); await flush(); });
+    let peer = f.handle.result!.participants.find(p => !p.isLocal)!;
+    expect(peer.streams[0]).toBe(cameraStream);
+    expect(peer.screenStream).toBeUndefined();
