node_modules/
dist/
# The production build's module-graph check (scripts/node-free-graph.mjs).
.module-graph.json
.vite/
.env.local
.env.*.local

# Playwright artifacts (built by the e2e test runs)
test-results/
e2e-report/
e2e-shots/
playwright-report/
# Recorded demo takes (playwright.demo.config.ts) — multi-megabyte video per run
e2e-demo/
# Throwaway UI-discovery specs (.claude/skills/demo-recording). Reserved prefix
# so a leftover probe can never ship, and so playwright.config.ts picking it up
# costs nothing.
e2e/zz-*.spec.ts
# Built prototypes — a self-contained ~800KB page per build. The source is
# what we keep; the artifact is regenerated by `npm run prototype:build`.
prototypes/*/build/
