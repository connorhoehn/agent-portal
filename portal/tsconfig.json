{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // Tests run on `node --test`, which strips types but resolves real files —
    // so they import `../answerSources.ts` by its actual name. Safe here
    // because nothing is emitted: vite resolves app imports, tsc only checks.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      // ui-components' integrations entry types its imports against the canonical
      // package name; map the subpaths it uses onto the installed dist typings.
      "@connorhoehn/realtime-modules/client": ["./node_modules/@connorhoehnslalom/realtime-modules/dist/client/index.d.ts"],
      "@connorhoehn/realtime-modules/client/video": ["./node_modules/@connorhoehnslalom/realtime-modules/dist/client/video/index.d.ts"],
      "@connorhoehn/realtime-modules/client/hangout-rooms": ["./node_modules/@connorhoehnslalom/realtime-modules/dist/client/hangout-rooms/index.d.ts"],
      "@connorhoehn/realtime-modules/call": ["./node_modules/@connorhoehnslalom/realtime-modules/dist/call/index.d.ts"]
    }
  },
  "include": ["src"]
}
