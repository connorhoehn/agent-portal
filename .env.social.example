# Variables for the `social` docker-compose profile (docs/social-calls-local-stack.md).
# Every one is optional: docker-compose.yml carries the default shown here.
# To override, copy to .env.social and pass it explicitly:
#   docker compose --env-file .env.social --profile social up -d --build
# (--env-file replaces the default .env for interpolation; it does not merge.)

# ── Build ────────────────────────────────────────────────────────────────────
# GitHub token for the LVS SFU image. live-video-streaming's Dockerfile rewrites
# its github: pins (distributed-core, event-catalog) to HTTPS and reads this as
# a BuildKit secret. Export it in the shell rather than storing it here:
#   export GH_TOKEN=$(gh auth token)
# The gateway and platform-api images use your ssh-agent instead (ssh-add -l).
# GH_TOKEN=

# ── Host ports (all bound to 127.0.0.1) ─────────────────────────────────────
# websocket-gateway. The portal's VITE_GATEWAY_URL points at ws://localhost:<this>.
# 18080 is also realtime-examples' Tilt port — run one stack or the other,
# or move this one.
SOCIAL_GATEWAY_PORT=18080
# platform-api (video sessions, participant tokens). Same clash note (13001).
SOCIAL_PLATFORM_API_PORT=13001
# Redis and DynamoDB Local are published only for debugging and for the
# host-SFU variant; nothing in the stack needs them on the host.
SOCIAL_REDIS_PORT=6379
SOCIAL_DYNAMODB_PORT=8000
# The SFU is fixed at 3901 (HTTP), 40000-40001/udp and 40010-40011/tcp (RTC):
# mediasoup announces the port it binds, so host and container ports must match.

# ── Shared secrets (local literals; match realtime-examples' Tilt values) ────
# LVS admin bearer. The SFU reads it as ADMIN_TOKEN, platform-api as
# VIDEO_ADMIN_TOKEN (it creates channels and mints participant tokens with it).
SOCIAL_LVS_ADMIN_TOKEN=admin
# HMAC secret on LVS → platform-api recording webhooks. The SFU reads it as
# WEBHOOK_HMAC_SECRET, platform-api as LVS_WEBHOOK_SECRET.
SOCIAL_LVS_WEBHOOK_SECRET=dev-lvs-webhook-secret
# Envelope-signing secret between the gateway and platform-api (SERVICE_AUTH_SECRET).
SOCIAL_SERVICE_AUTH_SECRET=local-dev-service-auth-secret
# The credential platform-api calls the SFU's /api/sessions lifecycle with, as
# a service: the SFU reads it as LVS_SERVICE_TOKEN, platform-api as
# VIDEO_SERVICE_TOKEN. No user bearer is forwarded to the SFU.
SOCIAL_LVS_SERVICE_TOKEN=local-dev-lvs-service-token

# ── Video wiring ─────────────────────────────────────────────────────────────
# Where platform-api reaches the SFU (VIDEO_API_URL). Default is the container.
# For the host-SFU variant use http://host.docker.internal:3901.
SOCIAL_VIDEO_API_URL=http://social-sfu:3901
# The SFU URL handed to the BROWSER in session responses (VIDEO_PUBLIC_URL).
SOCIAL_VIDEO_PUBLIC_URL=http://localhost:3901
# Where LVS POSTs recording events (platform-api's LVS_WEBHOOK_BOOTSTRAP_URL;
# platform-api registers it with LVS at boot). For the host-SFU variant use
# http://localhost:${SOCIAL_PLATFORM_API_PORT}/hooks/lvs/recording.
SOCIAL_LVS_WEBHOOK_BOOTSTRAP_URL=http://social-platform-api:3001/hooks/lvs/recording
# IP the SFU advertises in ICE candidates. 127.0.0.1 works for browsers on this
# machine only; use the Mac's LAN IP to take a call from another device.
SOCIAL_MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# platform-api: how long (ms) before an unheartbeated video session counts as
# stale. Empty = platform-api's built-in default.
SOCIAL_VIDEO_SESSION_STALE_MS=

# ── Identity ─────────────────────────────────────────────────────────────────
# platform-api verifies the OrgIQ realtime token (HS256, iss orgiq-middleware,
# aud realtime, tokenKind orgiq-hs256) with this secret — the same one the
# middleware signs with (its dev fallback when REALTIME_JWT_SECRET is unset
# there). A forged or expired OrgIQ token is refused with 401.
SOCIAL_REALTIME_JWT_SECRET=orgiq-dev-realtime
# The bypasses (refused by each service under NODE_ENV=production). Calls do
# not need them since 2026-09-29; they default on for the gateway and the other
# platform-api surfaces. false = platform-api accepts only verified tokens
# (OrgIQ HS256 or Cognito), the SFU only the service token or Cognito.
SOCIAL_PLATFORM_SKIP_AUTH=true
SOCIAL_LVS_AUTH_BYPASS=true
# A syntactically valid Cognito pool id is still needed at boot; it is never
# contacted unless a Cognito-shaped (RS256) token arrives.
SOCIAL_COGNITO_REGION=us-east-1
SOCIAL_COGNITO_USER_POOL_ID=us-east-1_localdev000

# ── The middleware as the gateway (middleware env, NOT read by compose) ─────
# Since 2026-09-29 the middleware serves the realtime gateway itself on
# ws://localhost:3001/ws (middleware/src/lib/realtime-gateway.ts), so
# `social-gateway` is optional: start the profile without it and point the
# portal at the middleware (VITE_GATEWAY_URL=http://localhost:3001 → /ws).
# These three are set in the middleware's environment (its shell, or
# middleware/.env*), not passed to docker compose:
#
# on|off. Default: on outside NODE_ENV=production, off in production.
# REALTIME_GATEWAY=on
# Call state in Redis when set (redis:// only, no TLS); memory otherwise.
# /api/health reports which: realtime.store. For this profile's Redis:
# REDIS_URL=redis://127.0.0.1:6379
# HS256 secret the token bridge signs with AND the /ws gateway verifies with.
# Unset in development → the dev secret 'orgiq-dev-realtime'; unset in
# production → no tokens are signed and every /ws upgrade is refused.
# platform-api verifies it too (SOCIAL_REALTIME_JWT_SECRET must match).
# REALTIME_JWT_SECRET=

# ── Gateway tuning ───────────────────────────────────────────────────────────
SOCIAL_LOG_LEVEL=info
# ENABLED_SERVICES for the gateway. `call` and `social` register regardless;
# the list gates the rest and what the capability endpoint reports.
SOCIAL_GATEWAY_SERVICES=chat,presence,cursor,reaction,crdt,call,room,activity,social,subscribe,notification

# ── Assessment document grants (read by compose; set by scripts/social-documents.mjs) ─
# Empty = no grant verifier on the gateway, open dev fixture auth on
# platform-api (the behaviour before 2026-09-29). The script fills them from
# .scratch/social-documents/settings.json; only the PUBLIC key goes here.
# SOCIAL_DOCUMENT_TENANT_ID=assessment
# SOCIAL_DOCUMENT_GRANT_ISSUER=
# SOCIAL_DOCUMENT_GRANT_KEY_ID=
# SOCIAL_DOCUMENT_GRANT_PUBLIC_KEY=
# SOCIAL_DOCUMENT_SESSION_EPOCH_URL=http://host.docker.internal:3001/internal/document-grants/session
# SOCIAL_DOCUMENT_POLICY_SECRET=

# ── Meeting assistant, real audio (docs/meeting-assistant-design.md, "Running it against real media") ─
# The three settings the middleware needs to arm the media server's per-participant audio tap for a call Nova listens to. All three,
# or inviting Nova on a real session answers 503. Values stay out of this file (the token is the media server's admin token).
# The media server's address as the middleware reaches it, and its admin token:
# MEETING_ASSISTANT_MEDIA_URL=
# MEETING_ASSISTANT_MEDIA_ADMIN_TOKEN=
# The address the MEDIA SERVER reaches the middleware at (the tap posts audio there), e.g. http://host.docker.internal:<middleware port>:
# MEETING_ASSISTANT_SINK_BASE_URL=
# The shared secret the media server sends with every audio post (the same value as its LIVE_CAPTIONS_SHARED_SECRET; set its LIVE_CAPTIONS_ORIGIN to the
# origin above). Required to arm taps; only INSECURE_DEV_MODE=true runs without it, with the sink open:
# MEETING_ASSISTANT_SINK_SECRET=
