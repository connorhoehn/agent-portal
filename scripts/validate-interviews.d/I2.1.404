# Row I2.1: the invite link and the guest identity. Format at parseRefusalTable (scripts/journeys/interviews/seed.mjs).
# The guest's own read answers the guest only; staff and a caller with no session get the guest refusal (not-found).
GET /api/interview-invite/interview | anon recruiter interviewer interviewer2 hiringManager workOnly | guest
# The recruiter's routes for the link: an interviewer and a hiring manager hold no ManageCandidates and read not-found
# (the interviews action gate, lib/interviews/gate.ts: never 403 inside the tenant); the tenant gate stops a guest, a
# caller with no session and a Work-only person (403). The POST and DELETE use Aiko's round so the
# guest's own link (Mateo's design round) is never replaced while the table runs.
GET /api/interviews/interviews/{interviews.mateoDesign}/invite | interviewer interviewer2 hiringManager guest=403 guest:aikoCoding=403 anon=403 workOnly=403 | recruiter
POST /api/interviews/interviews/{interviews.aikoCoding}/invite | interviewer interviewer2 hiringManager guest=403 anon=403 workOnly=403 | recruiter
DELETE /api/interviews/interviews/{interviews.aikoCoding}/invite | interviewer interviewer2 hiringManager guest=403 anon=403 workOnly=403 | recruiter
