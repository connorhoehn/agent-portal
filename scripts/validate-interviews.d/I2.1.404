# Row I2.1: the invite link and the guest identity. Format at parseRefusalTable (scripts/journeys/interviews/seed.mjs).
# The guest's own read answers the guest only; staff and a caller with no session get the guest refusal (not-found).
GET /api/interview-invite/interview | anon recruiter interviewer interviewer2 hiringManager workOnly | guest
# The recruiter's routes for the link: the role gate (requireAction ManageCandidates) answers 403 to an interviewer and
# a hiring manager, before any scope rule (a finding against the standing 404 rule, reported); the tenant gate stops a
# guest, a caller with no session and a Work-only person (403). The POST and DELETE use Aiko's round so the
# guest's own link (Mateo's design round) is never replaced while the table runs.
GET /api/interviews/interviews/{interviews.mateoDesign}/invite | interviewer=403 interviewer2=403 hiringManager=403 guest=403 guest:aikoCoding=403 anon=403 workOnly=403 | recruiter
POST /api/interviews/interviews/{interviews.aikoCoding}/invite | interviewer=403 interviewer2=403 hiringManager=403 guest=403 anon=403 workOnly=403 | recruiter
DELETE /api/interviews/interviews/{interviews.aikoCoding}/invite | interviewer=403 interviewer2=403 hiringManager=403 guest=403 anon=403 workOnly=403 | recruiter
