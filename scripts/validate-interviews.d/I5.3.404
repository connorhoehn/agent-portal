# Row I5.3: the scorecard (decisions 14, 15). GET: a seat reads its own and the others' only once its own is in; the recruiter
# and the opening's hiring manager read every submission and submit none; another round's interviewer and another opening's
# hiring manager get 404. POST: ConductInterview (recruiter and hiring manager 403 at the action) plus the seat (else 404).
# An empty body is a 400 for a seat, so no line writes.
GET /api/interviews/interviews/{interviews.ingridCoding}/scorecard | interviewer2 workOnly=403 anon=403 guest=403 | recruiter hiringManager interviewer
GET /api/interviews/interviews/{interviews.ingridTogether}/scorecard | interviewer workOnly=403 anon=403 guest=403 | recruiter hiringManager interviewer2
GET /api/interviews/interviews/{interviews.mateoCoding}/scorecard | interviewer2 workOnly=403 anon=403 guest=403 | recruiter hiringManager interviewer
GET /api/interviews/interviews/{interviews.raviCoding}/scorecard | interviewer hiringManager workOnly=403 anon=403 guest=403 | recruiter interviewer2
GET /api/interviews/interviews/{interviews.jonahLeadership}/scorecard | interviewer workOnly=403 anon=403 guest=403 | recruiter hiringManager interviewer2
POST /api/interviews/interviews/{interviews.jonahLeadership}/scorecard | recruiter=403 hiringManager=403 interviewer workOnly=403 anon=403 guest=403 | interviewer2 | {}
POST /api/interviews/interviews/{interviews.mateoCoding}/scorecard | recruiter=403 hiringManager=403 interviewer2 workOnly=403 anon=403 guest=403 | interviewer | {}
POST /api/interviews/interviews/{interviews.raviCoding}/scorecard | recruiter=403 hiringManager=403 interviewer workOnly=403 anon=403 guest=403 | interviewer2 | {}
