# Row I1.6: the résumé of Mateo (a seeded résumé; Hugo has rounds on him, Amara reads him, Wen has none). A body of {} is
# read as "not a PDF" (415) and writes nothing; DELETE is only ever sent by someone refused, or by nobody (the recruiter's
# delete is walked, not listed here, so the table never removes the file). The recruiter alone writes.
GET    /api/interviews/candidates/{candidates.mateo}/resume        | interviewer2 workOnly=403 anon=403 guest=403 | recruiter interviewer hiringManager
GET    /api/interviews/candidates/{candidates.mateo}/resume/file   | interviewer2 workOnly=403 anon=403 guest=403 | recruiter interviewer hiringManager
PUT    /api/interviews/candidates/{candidates.mateo}/resume        | interviewer=403 interviewer2=403 hiringManager=403 workOnly=403 anon=403 guest=403 | recruiter | {}
DELETE /api/interviews/candidates/{candidates.mateo}/resume        | interviewer=403 interviewer2=403 hiringManager=403 workOnly=403 anon=403 guest=403
