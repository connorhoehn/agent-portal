-- Generated by schema/seeds/generate_work_item_keys.py. Apply after orgiq_work_items_schema.sql.
-- Public keys are permanent references for commits/PRs; internal IDs and links stay valid.
ALTER TABLE work_items ADD COLUMN IF NOT EXISTS work_item_key TEXT;

-- Keep namespaces and counters after project/item deletion: a published key is never reused.
-- Seed reservations may precede the project rows, so this table intentionally has no FK.
CREATE TABLE IF NOT EXISTS work_item_key_namespaces (
  project_id TEXT PRIMARY KEY,
  prefix TEXT NOT NULL UNIQUE CHECK (prefix ~ '^ORG-[A-Z0-9]+(-[A-Z0-9]+)*$'),
  next_number BIGINT NOT NULL CHECK (next_number > 0)
);

INSERT INTO work_item_key_namespaces (project_id, prefix, next_number) VALUES
{{NAMESPACES}}
ON CONFLICT (project_id) DO UPDATE
SET next_number = GREATEST(work_item_key_namespaces.next_number, EXCLUDED.next_number);

-- Reserve the checked-in keys before allocating keys to legacy/custom work.
UPDATE work_items wi SET work_item_key = seed.work_item_key
FROM (VALUES
{{SEED_KEYS}}
) AS seed(id, project_id, work_item_key)
WHERE wi.id = seed.id AND wi.project_id = seed.project_id AND wi.work_item_key IS NULL;

CREATE OR REPLACE FUNCTION assign_work_item_key() RETURNS TRIGGER AS $$
DECLARE
  namespace_prefix TEXT;
  allocated_number BIGINT;
BEGIN
  IF TG_OP = 'UPDATE' AND OLD.work_item_key IS NOT NULL THEN
    IF NEW.work_item_key IS DISTINCT FROM OLD.work_item_key OR NEW.project_id IS DISTINCT FROM OLD.project_id THEN
      RAISE EXCEPTION 'Work-item keys and their initiative are immutable';
    END IF;
    RETURN NEW;
  END IF;

  INSERT INTO work_item_key_namespaces (project_id, prefix, next_number)
  VALUES (NEW.project_id,
    'ORG-' || COALESCE(NULLIF(TRIM(BOTH '-' FROM UPPER(REGEXP_REPLACE(REGEXP_REPLACE(NEW.project_id, '^p-', ''), '[^a-zA-Z0-9]+', '-', 'g'))), ''), 'WORK')
      || '-' || UPPER(SUBSTR(MD5(NEW.project_id), 1, 6)), 1)
  ON CONFLICT (project_id) DO NOTHING;
  SELECT prefix INTO namespace_prefix FROM work_item_key_namespaces WHERE project_id = NEW.project_id;

  IF NEW.work_item_key IS NULL THEN
    -- The UPDATE locks one namespace row; concurrent inserts receive distinct numbers.
    UPDATE work_item_key_namespaces SET next_number = next_number + 1
    WHERE project_id = NEW.project_id RETURNING next_number - 1 INTO allocated_number;
    NEW.work_item_key := namespace_prefix || '-' || allocated_number;
  ELSE
    IF NEW.work_item_key !~ ('^' || namespace_prefix || '-[1-9][0-9]*$') THEN
      RAISE EXCEPTION 'Work-item key does not match its initiative namespace';
    END IF;
    allocated_number := SPLIT_PART(NEW.work_item_key, '-', ARRAY_LENGTH(STRING_TO_ARRAY(NEW.work_item_key, '-'), 1))::BIGINT;
    UPDATE work_item_key_namespaces SET next_number = GREATEST(next_number, allocated_number + 1)
    WHERE project_id = NEW.project_id;
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS work_item_key_assignment ON work_items;
CREATE TRIGGER work_item_key_assignment BEFORE INSERT OR UPDATE OF work_item_key, project_id
ON work_items FOR EACH ROW EXECUTE FUNCTION assign_work_item_key();

-- Existing non-seed items also receive a stored key, exactly once.
UPDATE work_items SET work_item_key = NULL WHERE work_item_key IS NULL;
ALTER TABLE work_items ALTER COLUMN work_item_key SET NOT NULL;
CREATE UNIQUE INDEX IF NOT EXISTS work_items_key_unique ON work_items (work_item_key);
COMMENT ON COLUMN work_items.work_item_key IS 'Immutable human-readable reference, e.g. ORG-OBS-2, for commit messages and PRs.';
