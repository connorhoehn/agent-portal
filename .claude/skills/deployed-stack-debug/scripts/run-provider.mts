// Run one middleware provider function locally against the DEPLOYED Aurora
// (middleware/.env.aws, regenerated by ./schema/dump-stack-outputs.sh), so the
// real Data API error surfaces instead of a route's generic 503. Mocked-Aurora
// tests never reach the SQL; this does.
//
//   npx tsx run-provider.mts --module src/providers/document-drafts.ts --export createDocumentDraft \
//     --args '[{"title":"x","sectionKey":"workspace_drafts"}]' [--session u-farah:assessment:lead-assessor]
//
// --session appends a Session built from the user's real grants and epoch as
// the last argument. WRITES ARE REAL: a create creates a row in the deployed
// database. Prefer read functions unless the write is the thing under test.
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { arg, assertLabAccount, directoryUser, middleware, mwSource } from './lib.mts';

assertLabAccount();
if (!existsSync(resolve(middleware, '.env.aws'))) throw new Error('middleware/.env.aws is missing: run ./schema/dump-stack-outputs.sh');
process.env.MOCK_AURORA = 'false';
process.env.DEV_OFFLINE = '';
const modulePath = arg('module'); const exportName = arg('export');
if (!modulePath || !exportName) throw new Error('--module and --export are required');
const callArgs: unknown[] = JSON.parse(arg('args', '[]')!);
const sessionSpec = arg('session');
if (sessionSpec) {
  const [sub, tenant, role] = sessionSpec.split(':');
  const user = directoryUser(sub!);
  callArgs.push({ sub, tenant, role, name: user.name, grants: user.grants, epoch: user.epoch, iat: Math.floor(Date.now() / 1000) });
}
const mod = await mwSource(modulePath);
if (typeof mod[exportName] !== 'function') throw new Error(`${modulePath} has no function ${exportName}`);
try {
  console.log('OK', JSON.stringify(await mod[exportName](...callArgs), null, 2).slice(0, 4000));
} catch (error: any) {
  console.log('ERR', error?.constructor?.name, error?.status ?? '', error?.message);
  if (error?.cause) console.log('CAUSE', error.cause?.message ?? error.cause);
}
process.exit(0);
