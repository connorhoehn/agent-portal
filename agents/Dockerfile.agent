# syntax=docker/dockerfile:1.7
#
# Shared agent Dockerfile. Every OrgIQ Strands agent uses this.
#
# Build context is `agents/` (the parent of each agent dir + _shared/).
# AGENT_NAME picks the per-agent source. _shared/ is always copied so the
# in-process import `from _shared.approval_tool import ...` resolves at
# runtime — observability + HITL helpers live there.
#
# Invoke via agents/build-all.sh.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG AGENT_NAME

# Agent's own main.py + pyproject.
COPY --chown=bedrock_agentcore:bedrock_agentcore ${AGENT_NAME}/ /app/
# Shared modules (approval_tool, instrumentation) — imported by every agent.
COPY --chown=bedrock_agentcore:bedrock_agentcore _shared /app/_shared
