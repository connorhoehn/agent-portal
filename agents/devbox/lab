#!/usr/bin/env bash
# lab — the devbox agent's line to the outside world.
#
# Claude Code sessions in this microVM are ephemeral (the workspace is a
# cache). This CLI is how a run reaches the parts of the platform that
# OUTLIVE it, over the middleware's sessionless lab callbacks:
#
#   lab signal <critical|warning|info> "<title>" ["detail"]
#       File an issue you noticed OUTSIDE your task — it lands on the org's
#       findings board (Work page), where a person can promote it into a job.
#
#   lab remember <worked|failed|gotcha|decision|convention> "<title>" ["body"]
#       Record a learning for the fleet. Future sessions on this repo recall
#       it before starting work.
#
#   lab brief
#       Print this run's session brief — the task, the project, the decisions
#       that bind it and the runbooks selected for it, frozen when the run was
#       dispatched. The SessionStart hook runs it. Byte-identical to the brief
#       a person reads on the run (same sha256, checked here).
#
#   lab runbook <runbook-id>
#       Print one of the org's skills (a runbook) as markdown, at the version
#       this run was given.
#
#   lab skills
#       Sync the org's skill library into ~/.claude/skills (LAB_SKILLS_DIR):
#       every published runbook as <id>/SKILL.md + scripts/ + data/. One copy,
#       skipped when the library's sha is unchanged; every file's sha256, the
#       set's sha and every path are verified before anything is replaced.
#       `lab brief` runs it first. Never overwrites a skill it did not install.
#
#   lab keep [--dry-run]
#       Propose each tool you kept in .lab/keep/<rb-name>/ (SKILL.md + scripts/
#       + data/) as a new skill, or an edit of an installed one, with its
#       files. The SessionEnd hook runs it. A person reviews every proposal;
#       nothing reaches the library until they accept it. --dry-run prints the
#       proposal bodies and sends nothing.
#
#   lab applied <runbook-id> <followed|followed_with_deviation|failed|not_used> [--step N] ["note"]
#       Say whether you followed a runbook from your brief. A run that failed
#       at a step names it. This is what the runbook's health is counted from.
#
#   lab propose <runbook-id|new> <file.md> ["why"]
#       Propose the corrected (or a new) runbook, as canonical runbook
#       markdown. A person reviews it; it never changes a runbook by itself.
#
#   lab recall
#       Print the fleet's raw run notes for this repo (manual; the brief
#       replaced it at session start).
#
#   lab consult "<question>" ["context"]
#       Ask a human and WAIT (poll ≤10min). Prints the answer, or times out.
#       Use when genuinely blocked on a judgment call — a consult holds a
#       person's attention and your own runtime budget.
#
# Config (set by the runtime / CDK stack):
#   LAB_API_BASE        middleware origin, e.g. https://orgiq.example.com
#   LAB_CALLBACK_SECRET optional; when set every call carries a signed
#                       X-Service-Auth envelope + x-service-nonce (lane C4),
#                       plus x-lab-auth unless SERVICE_AUTH_LEGACY_HEADERS=refuse
#   LAB_RUN_REF / LAB_RUN_TOKEN  the run this session is, and the per-run token
#                       that proves it (brief, applied, propose, runbook); set by
#                       main.py from the invoke payload, absent outside a run
#   LAB_SESSION_ID / LAB_BOX_ID / LAB_REPO / LAB_INITIATIVE_ID / LAB_WORK_ITEM_ID  attribution
#   LAB_SKILLS_DIR      where `lab skills` installs (default ~/.claude/skills)
#   LAB_KEEP_DIR        where `lab keep` looks (default .lab/keep)
set -euo pipefail

BASE="${LAB_API_BASE:-}"
if [ -z "$BASE" ] && ! { [ "${1:-}" = "keep" ] && [ "${2:-}" = "--dry-run" ]; }; then
  echo "lab: LAB_API_BASE is not set — the lab loop is not wired in this environment." >&2
  exit 0   # soft: a missing loop must never fail an agent's bash step
fi

# Service auth (middleware lib/service-auth.ts, LAB_CALLBACK_SERVICE_AUTH).
# Unset secret → no headers at all. Set → service-runtime's signed request
# envelope over (method, path+query, exact body, audience#nonce), the same
# wire format agents/_shared/callbacks.py signs; the static x-lab-auth header
# rides along until the transition flag says refuse. Signed per request: each
# envelope is single-use.
auth=()
sign() { # $1=METHOD $2=path+query $3=exact body → fills auth=()
  auth=()
  local secret="${LAB_CALLBACK_SECRET:-}"
  secret="${secret#"${secret%%[![:space:]]*}"}"; secret="${secret%"${secret##*[![:space:]]}"}"
  [ -n "$secret" ] || return 0
  if [ "$(printf '%s' "${SERVICE_AUTH_LEGACY_HEADERS:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')" != "refuse" ]; then
    auth+=(-H "x-lab-auth: ${secret}")
  fi
  local lines
  lines=$(LAB_SIGN_SECRET="$secret" python3 -I -c '
import base64, hashlib, hmac, json, os, secrets, sys, time
method, target, body = sys.argv[1], sys.argv[2], sys.argv[3]
nonce = secrets.token_urlsafe(18)
payload = json.dumps({"protocol": "service-http-v1", "audience": "orgiq-middleware/lab#" + nonce,
                      "method": method.upper(), "target": target, "body": body},
                     sort_keys=True, separators=(",", ":"), ensure_ascii=False)
ts = int(time.time())
mac = hmac.new(os.environ["LAB_SIGN_SECRET"].encode(), f"orgiq-devbox.{ts}.{payload}".encode(), hashlib.sha256).digest()
print("X-Service-Auth: v1.orgiq-devbox.%d.%s" % (ts, base64.urlsafe_b64encode(mac).rstrip(b"=").decode()))
print("x-service-nonce: " + nonce)
' "$1" "$2" "$3") || return 0   # soft: an unsignable request goes out with the static header only
  while IFS= read -r line; do auth+=(-H "$line"); done <<<"$lines"
}

# The per-run token rides on every call when this session is a run: the
# envelope says "a box of the fleet", the token says "the box running THIS run".
run_hdr=()
if [ -n "${LAB_RUN_TOKEN:-}" ]; then run_hdr=(-H "x-lab-run-token: ${LAB_RUN_TOKEN}"); fi

need_run() { # soft: outside a dispatched run there is nothing to report against
  if [ -z "${LAB_RUN_REF:-}" ] || [ -z "${LAB_RUN_TOKEN:-}" ]; then
    echo "lab: this session is not a dispatched run (LAB_RUN_REF/LAB_RUN_TOKEN unset) — nothing to $1." >&2
    exit 0
  fi
}

urlq() { python3 -I -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }

repo="${LAB_REPO:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"

json_escape() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

base_path() { python3 -I -c 'import sys,urllib.parse; print(urllib.parse.urlsplit(sys.argv[1]).path.rstrip("/"))' "$BASE"; }
PREFIX="$(base_path)"

post() { # $1=path $2=json-body (sent byte for byte: --data-binary, never -d)
  sign POST "$PREFIX$1" "$2"
  curl -sS --max-time 15 -X POST "$BASE$1" -H 'content-type: application/json' ${auth[@]+"${auth[@]}"} ${run_hdr[@]+"${run_hdr[@]}"} --data-binary "$2"
}

get() { # $1=path+query
  sign GET "$PREFIX$1" ""
  curl -sS --max-time 15 ${auth[@]+"${auth[@]}"} ${run_hdr[@]+"${run_hdr[@]}"} "$BASE$1"
}

SKILLS_DIR="${LAB_SKILLS_DIR:-${HOME:-/tmp}/.claude/skills}"

# lab skills: one copy of the org's skill library, verified, skipped when unchanged.
sync_skills() { # $1 = --quiet
  local quiet="${1:-}" tmp code have=""
  mkdir -p "$SKILLS_DIR"
  have=$(python3 -I -c 'import json,sys
try: print(json.load(open(sys.argv[1]))["sha256"])
except Exception: print("")' "$SKILLS_DIR/.orgiq-library.json")
  tmp=$(mktemp -d)
  local target="/api/runs/$(urlq "$LAB_RUN_REF")/skills"
  sign GET "$PREFIX$target" ""
  # --max-filesize: the library is capped at 8 MiB of content; a response far past that is refused unread.
  code=$(curl -sS --max-time 30 --max-filesize 33554432 -o "$tmp/body" -D "$tmp/head" -w '%{http_code}' \
    ${auth[@]+"${auth[@]}"} ${run_hdr[@]+"${run_hdr[@]}"} ${have:+-H "If-None-Match: \"$have\""} "$BASE$target" || echo 000)
  if [ "$code" = "304" ]; then
    [ -n "$quiet" ] || echo "skills: library ${have:0:12} unchanged in $SKILLS_DIR"
    rm -rf "$tmp"; return 0
  fi
  if [ "$code" != "200" ]; then
    echo "skills: could not fetch the org's skill library (HTTP $code); the skills already in $SKILLS_DIR stay."
    rm -rf "$tmp"; return 0
  fi
  python3 -I - "$tmp/body" "$tmp/head" "$SKILLS_DIR" <<'PY'
import hashlib, json, os, re, shutil, sys, tempfile
body_path, head_path, skills_dir = sys.argv[1:4]
FMT = "orgiq-skill-library/1"
NAME = re.compile(r"^rb-[a-z0-9][a-z0-9-]{1,60}$")
SEG = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$")
FILE_MAX, LIB_MAX = 32 * 1024, 8 * 1024 * 1024
def refuse(why):
    print(f"skills: REFUSED the library ({why}); the skills already in {skills_dir} stay.")
    sys.exit(0)
raw = open(body_path, "rb").read()
if len(raw) > 4 * LIB_MAX: refuse("response too large")
lib = json.loads(raw)
want = ""
for line in open(head_path, encoding="latin-1"):
    k, _, v = line.partition(":")
    if k.strip().lower() == "x-skill-library-sha256": want = v.strip()
if lib.get("format") != FMT: refuse("unknown format")
total = 0
lines = []
by_skill = {}
for f in lib.get("files", []):
    path, content, mode, sha = f.get("path", ""), f.get("content", ""), f.get("mode"), f.get("sha256", "")
    parts = path.split("/")
    # <rb-name>/SKILL.md, or <rb-name>/(scripts|data)/<safe segments>: nothing absolute, nothing that climbs.
    ok = (len(parts) >= 2 and NAME.match(parts[0]) and
          ((len(parts) == 2 and parts[1] == "SKILL.md") or
           (len(parts) >= 3 and parts[1] in ("scripts", "data") and all(SEG.match(p) for p in parts[2:]))))
    if not ok: refuse(f"unsafe path {path!r}")
    if mode not in ("644", "755"): refuse(f"bad mode on {path}")
    data = content.encode("utf-8")
    if len(data) > FILE_MAX: refuse(f"{path} is over {FILE_MAX} bytes")
    if hashlib.sha256(data).hexdigest() != sha: refuse(f"{path} does not match its sha256")
    total += len(data)
    lines.append(f"{path} {mode} {sha}")
    by_skill.setdefault(parts[0], []).append((parts[1:], data, mode))
if total > LIB_MAX: refuse("library over its size cap")
got = hashlib.sha256(("\n".join([FMT] + sorted(lines)) + "\n").encode()).hexdigest()
if got != lib.get("sha256") or (want and got != want): refuse("the set does not match its sha256")
state_path = os.path.join(skills_dir, ".orgiq-library.json")
try: prev = set(json.load(open(state_path))["skills"])
except Exception: prev = set()
stage = tempfile.mkdtemp(prefix=".orgiq-stage-", dir=skills_dir)
installed, skipped = [], []
try:
    for name in sorted(by_skill):
        root = os.path.join(stage, name)
        for parts, data, mode in by_skill[name]:
            dest = os.path.join(root, *parts)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), int(mode, 8))
            with os.fdopen(fd, "wb") as fh: fh.write(data)
        target = os.path.join(skills_dir, name)
        if os.path.lexists(target) and name not in prev:
            skipped.append(name)  # someone else's skill of that name: never overwrite it
            continue
        if os.path.islink(target) or os.path.isfile(target): os.unlink(target)
        elif os.path.isdir(target): shutil.rmtree(target)
        os.rename(root, target)
        installed.append(name)
    removed = sorted(n for n in prev - set(by_skill) if NAME.match(n))
    for name in removed:
        t = os.path.join(skills_dir, name)
        if os.path.isdir(t) and not os.path.islink(t): shutil.rmtree(t)
finally:
    shutil.rmtree(stage, ignore_errors=True)
with open(state_path + ".tmp", "w") as fh:
    json.dump({"sha256": got, "skills": installed}, fh, sort_keys=True)
os.replace(state_path + ".tmp", state_path)
msg = f"skills: installed the org's library {got[:12]}: {len(installed)} skill(s) in {skills_dir}"
if removed: msg += f", {len(removed)} retired removed"
if skipped: msg += f"; skipped {', '.join(skipped)} (a skill of that name is already there and is not the library's)"
print(msg)
PY
  rm -rf "$tmp"
}

common_fields() {
  printf '"sessionId":%s,"boxId":%s,"repo":%s,"initiativeId":%s' \
    "$(json_escape "${LAB_SESSION_ID:-}")" "$(json_escape "${LAB_BOX_ID:-}")" \
    "$(json_escape "$repo")" "$(json_escape "${LAB_INITIATIVE_ID:-}")"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  signal)
    sev="${1:?usage: lab signal <critical|warning|info> \"title\" [detail]}"
    title="${2:?title required}"; detail="${3:-}"
    post /api/lab/signals "{\"severity\":$(json_escape "$sev"),\"title\":$(json_escape "$title"),\"detail\":$(json_escape "$detail"),$(common_fields)}" \
      | python3 -c 'import json,sys; f=json.load(sys.stdin).get("finding",{}); print(f"filed: {f.get(chr(105)+chr(100))} → Work page findings")'
    ;;
  remember)
    kind="${1:?usage: lab remember <worked|failed|gotcha|decision|convention> \"title\" [body]}"
    title="${2:?title required}"; body="${3:-}"
    post /api/lab/experiences "{\"kind\":$(json_escape "$kind"),\"title\":$(json_escape "$title"),\"body\":$(json_escape "$body"),$(common_fields)}" >/dev/null \
      && echo "remembered for $repo"
    ;;
  brief)
    if [ -z "${LAB_RUN_REF:-}" ] || [ -z "${LAB_RUN_TOKEN:-}" ]; then
      echo "No session brief: this session was not started by a dispatched run."
      exit 0   # soft: an interactive session has no brief, and SessionStart must not fail
    fi
    # The org's skills first (one verified copy, skipped when unchanged), then the brief that points at them.
    sync_skills
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    target="/api/runs/$(urlq "$LAB_RUN_REF")/brief?format=markdown"
    sign GET "$PREFIX$target" ""
    code=$(curl -sS --max-time 15 -o "$tmp/body" -D "$tmp/head" -w '%{http_code}' \
      ${auth[@]+"${auth[@]}"} ${run_hdr[@]+"${run_hdr[@]}"} "$BASE$target" || echo 000)
    if [ "$code" != "200" ]; then
      echo "No session brief could be fetched for run $LAB_RUN_REF (HTTP $code). Work from the task prompt." 
      exit 0
    fi
    # Print the frozen bytes verbatim, and check they are the bytes the run was stamped with.
    python3 -I -c '
import hashlib, sys
body = open(sys.argv[1], "rb").read()
want = ""
for line in open(sys.argv[2], encoding="latin-1"):
    k, _, v = line.partition(":")
    if k.strip().lower() == "x-brief-sha256": want = v.strip()
sys.stdout.write(body.decode("utf-8"))
got = hashlib.sha256(body).hexdigest()
if want and got != want:
    print(f"lab: WARNING the brief bytes do not match their sha ({got} != {want})", file=sys.stderr)
' "$tmp/body" "$tmp/head"
    ;;
  skills)
    need_run "sync"
    sync_skills "${1:-}"
    ;;
  keep)
    dry=""; [ "${1:-}" = "--dry-run" ] && dry=1
    keep_dir="${LAB_KEEP_DIR:-.lab/keep}"
    [ -d "$keep_dir" ] || { [ -n "$dry" ] || echo "lab: nothing kept ($keep_dir does not exist)."; exit 0; }
    bodies=$(LAB_SKILLS_DIR="$SKILLS_DIR" python3 -I - "$keep_dir" "${LAB_RUN_REF:-}" "${LAB_SESSION_ID:-}" <<'PY'
import json, os, re, stat, sys
keep, run_ref, session = sys.argv[1:4]
skills_dir = os.environ["LAB_SKILLS_DIR"]
NAME = re.compile(r"^rb-[a-z0-9][a-z0-9-]{1,60}$")
SEG = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$")
FILE_MAX, BUNDLE_MAX, MAX_FILES = 32 * 1024, 80 * 1024, 24
try:
    installed = set(json.load(open(os.path.join(skills_dir, ".orgiq-library.json")))["skills"])
except Exception:
    installed = set()
for name in sorted(os.listdir(keep)):
    base = os.path.join(keep, name)
    if os.path.islink(base) or not os.path.isdir(base):
        continue
    problems = []
    if not NAME.match(name):
        problems.append("the folder name must look like rb-some-name (it becomes the skill's name)")
    skill_md = os.path.join(base, "SKILL.md")
    if os.path.islink(skill_md) or not os.path.isfile(skill_md):
        problems.append("no SKILL.md")
    files = []
    total = 0
    for root_name in ("scripts", "data"):
        top = os.path.join(base, root_name)
        if not os.path.exists(top):
            continue
        for dirpath, dirnames, filenames in os.walk(top, followlinks=False):
            for d in dirnames:
                if os.path.islink(os.path.join(dirpath, d)):
                    problems.append(f"{os.path.relpath(os.path.join(dirpath, d), base)} is not a regular file (links are not carried)")
            dirnames[:] = sorted(d for d in dirnames if not os.path.islink(os.path.join(dirpath, d)))
            for fn in sorted(filenames):
                full = os.path.join(dirpath, fn)
                rel = os.path.relpath(full, base).replace(os.sep, "/")
                st = os.lstat(full)
                # Never follow a link: a kept "file" that points at ~/.ssh would ship a key.
                if not stat.S_ISREG(st.st_mode):
                    problems.append(f"{rel} is not a regular file (links are not carried)")
                    continue
                if not all(SEG.match(p) for p in rel.split("/")[1:]):
                    problems.append(f"{rel}: a name outside [A-Za-z0-9._-] or starting with . or -")
                    continue
                if st.st_size > FILE_MAX:
                    problems.append(f"{rel} is {st.st_size} bytes (max {FILE_MAX})")
                    continue
                raw = open(full, "rb").read()
                if b"\0" in raw:
                    problems.append(f"{rel} is binary (only text is carried)")
                    continue
                try:
                    text = raw.decode("utf-8")
                except UnicodeDecodeError:
                    problems.append(f"{rel} is not UTF-8 text")
                    continue
                total += len(raw)
                files.append({"path": rel, "content": text, "mode": "755" if (st.st_mode & 0o111) else "644"})
    if len(files) > MAX_FILES:
        problems.append(f"{len(files)} files (max {MAX_FILES})")
    if total > BUNDLE_MAX:
        problems.append(f"the files total {total} bytes (max {BUNDLE_MAX})")
    if problems:
        print(json.dumps({"name": name, "problems": problems}))
        continue
    edit = name in installed
    body = {
        "kind": "edit" if edit else "new",
        "skill_md": open(skill_md, encoding="utf-8").read(),
        "files": files,
        "rationale": f"Kept by run {run_ref or '(no run)'} in .lab/keep/{name}: a tool this run built and wants every box to have.",
        "source": {"run_ref": run_ref, "session_id": session, "lab_experience_ids": []},
    }
    if edit:
        body["runbook_id"] = name
    print(json.dumps({"name": name, "body": body}, sort_keys=True))
PY
)
    if [ -n "$dry" ]; then printf '%s\n' "$bodies"; exit 0; fi
    need_run "propose"
    [ -n "$bodies" ] || { echo "lab: nothing kept in $keep_dir."; exit 0; }
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      name=$(printf '%s' "$line" | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["name"])')
      problems=$(printf '%s' "$line" | python3 -I -c 'import json,sys; d=json.load(sys.stdin); print("; ".join(d.get("problems", [])))')
      if [ -n "$problems" ]; then echo "not proposed: $name — $problems"; continue; fi
      body=$(printf '%s' "$line" | python3 -I -c 'import json,sys; print(json.dumps(json.load(sys.stdin)["body"]))')
      post /api/runbooks/proposals "$body" | python3 -I -c 'import json,sys
r=json.load(sys.stdin); p=r.get("proposal"); n=sys.argv[1]
if p:
    errs=[f for f in p.get("lint",[]) if f.get("severity")=="error"]
    print("proposed: " + n + " as " + p["id"] + " with " + str(len(p.get("proposed_files") or [])) + " file(s) — a person reviews it" + (f"; {len(errs)} lint error(s) to fix first" if errs else ""))
else:
    print("not proposed: " + n + " — " + str(r.get("error")) + "".join("\n  " + str(x) for x in r.get("problems", [])))' "$name"
    done <<<"$bodies"
    ;;
  runbook)
    need_run "fetch"
    id="${1:?usage: lab runbook <runbook-id>}"
    get "/api/runs/$(urlq "$LAB_RUN_REF")/runbooks/$(urlq "$id")"
    ;;
  applied)
    need_run "report"
    id="${1:?usage: lab applied <runbook-id> <followed|followed_with_deviation|failed|not_used> [--step N] [note]}"
    outcome="${2:?outcome required: followed | followed_with_deviation | failed | not_used}"
    shift 2
    step=""; note=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --step) step="${2:?--step needs a number}"; shift 2 ;;
        --step=*) step="${1#--step=}"; shift ;;
        *) note="$1"; shift ;;
      esac
    done
    body=$(python3 -I -c '
import json, sys
run_ref, outcome, step, note = sys.argv[1:5]
d = {"run_ref": run_ref, "outcome": outcome}
if step: d["failed_at_step"] = int(step)
if note: d["note"] = note
print(json.dumps(d))' "$LAB_RUN_REF" "$outcome" "$step" "$note")
    post "/api/runbooks/$(urlq "$id")/applications" "$body" \
      | python3 -c 'import json,sys
r=json.load(sys.stdin); a=r.get("application")
print("recorded: " + a["runbook_id"] + " v" + str(a["version"]) + " " + a["outcome"] if a else "not recorded: " + str(r.get("error")))'
    ;;
  propose)
    need_run "propose"
    target="${1:?usage: lab propose <runbook-id|new> <file.md> [why]}"
    file="${2:?markdown file required}"; why="${3:-Proposed by run $LAB_RUN_REF.}"
    [ -f "$file" ] || { echo "lab: no such file: $file" >&2; exit 2; }
    body=$(python3 -I -c '
import json, os, sys
target, path, why, run_ref = sys.argv[1:5]
d = {"kind": "new" if target == "new" else "edit", "markdown": open(path, encoding="utf-8").read(), "rationale": why,
     "source": {"run_ref": run_ref, "session_id": os.environ.get("LAB_SESSION_ID", ""), "lab_experience_ids": []}}
if target != "new": d["runbook_id"] = target
print(json.dumps(d))' "$target" "$file" "$why" "$LAB_RUN_REF")
    post /api/runbooks/proposals "$body" \
      | python3 -c 'import json,sys
r=json.load(sys.stdin); p=r.get("proposal")
if p:
    errs=[f for f in p.get("lint",[]) if f.get("severity")=="error"]
    print("proposed: " + p["id"] + " (a person reviews it)" + (f" — {len(errs)} lint error(s) to fix first" if errs else ""))
else:
    print("not proposed: " + str(r.get("error")) + "".join("\n  " + str(x) for x in r.get("problems", [])))'
    ;;
  recall)
    get "/api/lab/experiences?repo=$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$repo")&limit=20" \
      | python3 -c '
import json, sys
exps = json.load(sys.stdin).get("experiences", [])
if not exps:
    print("No fleet memory for this repo yet.")
else:
    print(f"Fleet memory for this repo ({len(exps)} entries, newest first):")
    for e in exps:
        line = "- [" + e["kind"] + "] " + e["title"]
        if e.get("body"): line += " — " + e["body"]
        print(line)
'
    ;;
  consult)
    q="${1:?usage: lab consult \"question\" [context]}"; ctx="${2:-}"
    cid=$(post /api/lab/consults "{\"question\":$(json_escape "$q"),\"context\":$(json_escape "$ctx"),$(common_fields)}" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["consult"]["id"])')
    echo "consult $cid opened — waiting for a human (up to 10 min)…" >&2
    deadline=$(( $(date +%s) + 600 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      sleep 5
      out=$(get "/api/lab/consults/$cid" || true)
      status=$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin)["consult"]["status"])
except Exception: print("pending")')
      if [ "$status" = "answered" ]; then
        printf '%s' "$out" | python3 -c 'import json,sys; c=json.load(sys.stdin)["consult"]; print("ANSWER (from " + (c.get("answeredBy") or "a human") + "): " + c["answer"])'
        exit 0
      fi
      if [ "$status" = "expired" ] || [ "$status" = "withdrawn" ]; then break; fi
    done
    echo "No answer within the wait window. Proceed with your best judgment, note the assumption, and file it: lab remember decision \"...\"" >&2
    exit 0   # soft: an unanswered consult must not fail the run
    ;;
  *)
    sed -n '2,70p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
