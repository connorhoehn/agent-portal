#!/usr/bin/env bash
# lab — the devbox agent's line to the outside world.
#
# Claude Code sessions in this microVM are ephemeral (the workspace is a
# cache). This CLI is how a run reaches the parts of the platform that
# OUTLIVE it, over the middleware's sessionless lab callbacks:
#
#   lab signal <critical|warning|info> "<title>" ["detail"]
#       File an issue you noticed OUTSIDE your task — it lands on the org's
#       findings board (Work page), where a person can promote it into a job.
#
#   lab remember <worked|failed|gotcha|decision|convention> "<title>" ["body"]
#       Record a learning for the fleet. Future sessions on this repo recall
#       it before starting work.
#
#   lab recall
#       Print the fleet's memory for this repo. Run at session start.
#
#   lab consult "<question>" ["context"]
#       Ask a human and WAIT (poll ≤10min). Prints the answer, or times out.
#       Use when genuinely blocked on a judgment call — a consult holds a
#       person's attention and your own runtime budget.
#
# Config (set by the runtime / CDK stack):
#   LAB_API_BASE        middleware origin, e.g. https://orgiq.example.com
#   LAB_CALLBACK_SECRET optional; when set every call carries a signed
#                       X-Service-Auth envelope + x-service-nonce (lane C4),
#                       plus x-lab-auth unless SERVICE_AUTH_LEGACY_HEADERS=refuse
#   LAB_SESSION_ID / LAB_BOX_ID / LAB_REPO / LAB_INITIATIVE_ID  attribution
set -euo pipefail

BASE="${LAB_API_BASE:-}"
if [ -z "$BASE" ]; then
  echo "lab: LAB_API_BASE is not set — the lab loop is not wired in this environment." >&2
  exit 0   # soft: a missing loop must never fail an agent's bash step
fi

# Service auth (middleware lib/service-auth.ts, LAB_CALLBACK_SERVICE_AUTH).
# Unset secret → no headers at all. Set → service-runtime's signed request
# envelope over (method, path+query, exact body, audience#nonce), the same
# wire format agents/_shared/callbacks.py signs; the static x-lab-auth header
# rides along until the transition flag says refuse. Signed per request: each
# envelope is single-use.
auth=()
sign() { # $1=METHOD $2=path+query $3=exact body → fills auth=()
  auth=()
  local secret="${LAB_CALLBACK_SECRET:-}"
  secret="${secret#"${secret%%[![:space:]]*}"}"; secret="${secret%"${secret##*[![:space:]]}"}"
  [ -n "$secret" ] || return 0
  if [ "$(printf '%s' "${SERVICE_AUTH_LEGACY_HEADERS:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')" != "refuse" ]; then
    auth+=(-H "x-lab-auth: ${secret}")
  fi
  local lines
  lines=$(LAB_SIGN_SECRET="$secret" python3 -I -c '
import base64, hashlib, hmac, json, os, secrets, sys, time
method, target, body = sys.argv[1], sys.argv[2], sys.argv[3]
nonce = secrets.token_urlsafe(18)
payload = json.dumps({"protocol": "service-http-v1", "audience": "orgiq-middleware/lab#" + nonce,
                      "method": method.upper(), "target": target, "body": body},
                     sort_keys=True, separators=(",", ":"), ensure_ascii=False)
ts = int(time.time())
mac = hmac.new(os.environ["LAB_SIGN_SECRET"].encode(), f"orgiq-devbox.{ts}.{payload}".encode(), hashlib.sha256).digest()
print("X-Service-Auth: v1.orgiq-devbox.%d.%s" % (ts, base64.urlsafe_b64encode(mac).rstrip(b"=").decode()))
print("x-service-nonce: " + nonce)
' "$1" "$2" "$3") || return 0   # soft: an unsignable request goes out with the static header only
  while IFS= read -r line; do auth+=(-H "$line"); done <<<"$lines"
}

repo="${LAB_REPO:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"

json_escape() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

base_path() { python3 -I -c 'import sys,urllib.parse; print(urllib.parse.urlsplit(sys.argv[1]).path.rstrip("/"))' "$BASE"; }
PREFIX="$(base_path)"

post() { # $1=path $2=json-body (sent byte for byte: --data-binary, never -d)
  sign POST "$PREFIX$1" "$2"
  curl -sS --max-time 15 -X POST "$BASE$1" -H 'content-type: application/json' ${auth[@]+"${auth[@]}"} --data-binary "$2"
}

get() { # $1=path+query
  sign GET "$PREFIX$1" ""
  curl -sS --max-time 15 ${auth[@]+"${auth[@]}"} "$BASE$1"
}

common_fields() {
  printf '"sessionId":%s,"boxId":%s,"repo":%s,"initiativeId":%s' \
    "$(json_escape "${LAB_SESSION_ID:-}")" "$(json_escape "${LAB_BOX_ID:-}")" \
    "$(json_escape "$repo")" "$(json_escape "${LAB_INITIATIVE_ID:-}")"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  signal)
    sev="${1:?usage: lab signal <critical|warning|info> \"title\" [detail]}"
    title="${2:?title required}"; detail="${3:-}"
    post /api/lab/signals "{\"severity\":$(json_escape "$sev"),\"title\":$(json_escape "$title"),\"detail\":$(json_escape "$detail"),$(common_fields)}" \
      | python3 -c 'import json,sys; f=json.load(sys.stdin).get("finding",{}); print(f"filed: {f.get(chr(105)+chr(100))} → Work page findings")'
    ;;
  remember)
    kind="${1:?usage: lab remember <worked|failed|gotcha|decision|convention> \"title\" [body]}"
    title="${2:?title required}"; body="${3:-}"
    post /api/lab/experiences "{\"kind\":$(json_escape "$kind"),\"title\":$(json_escape "$title"),\"body\":$(json_escape "$body"),$(common_fields)}" >/dev/null \
      && echo "remembered for $repo"
    ;;
  recall)
    get "/api/lab/experiences?repo=$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$repo")&limit=20" \
      | python3 -c '
import json, sys
exps = json.load(sys.stdin).get("experiences", [])
if not exps:
    print("No fleet memory for this repo yet.")
else:
    print(f"Fleet memory for this repo ({len(exps)} entries, newest first):")
    for e in exps:
        line = "- [" + e["kind"] + "] " + e["title"]
        if e.get("body"): line += " — " + e["body"]
        print(line)
'
    ;;
  consult)
    q="${1:?usage: lab consult \"question\" [context]}"; ctx="${2:-}"
    cid=$(post /api/lab/consults "{\"question\":$(json_escape "$q"),\"context\":$(json_escape "$ctx"),$(common_fields)}" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["consult"]["id"])')
    echo "consult $cid opened — waiting for a human (up to 10 min)…" >&2
    deadline=$(( $(date +%s) + 600 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      sleep 5
      out=$(get "/api/lab/consults/$cid" || true)
      status=$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin)["consult"]["status"])
except Exception: print("pending")')
      if [ "$status" = "answered" ]; then
        printf '%s' "$out" | python3 -c 'import json,sys; c=json.load(sys.stdin)["consult"]; print("ANSWER (from " + (c.get("answeredBy") or "a human") + "): " + c["answer"])'
        exit 0
      fi
      if [ "$status" = "expired" ] || [ "$status" = "withdrawn" ]; then break; fi
    done
    echo "No answer within the wait window. Proceed with your best judgment, note the assumption, and file it: lab remember decision \"...\"" >&2
    exit 0   # soft: an unanswered consult must not fail the run
    ;;
  *)
    sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
